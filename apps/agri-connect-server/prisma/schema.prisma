datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
}

model Product {
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
}

model Farm {
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
}

model User {
  createdAt    DateTime          @default(now())
  email        String?           @unique
  firstName    String?
  id           String            @id @default(cuid())
  lastName     String?
  password     String
  role         EnumUserRole?
  roles        Json
  updatedAt    DateTime          @updatedAt
  userEmail    String?
  username     String            @unique
  userPassword String?
  userRole     EnumUserUserRole?
  userUsername String?
}

enum EnumUserRole {
  Option1
}

enum EnumUserUserRole {
  Option1
}
